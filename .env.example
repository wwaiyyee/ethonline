# Local infrastructure config for `docker-compose.yml` (yarn infra:up).
# Copy to `.env` and fill in the facilitator credentials.

# --- MinIO (private object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Bucket created on first `infra:up`. Must match S3_BUCKET in packages/nextjs/.env
S3_BUCKET=x402-files

# --- Self-hosted x402 Hedera facilitator ---
FACILITATOR_PORT=4020
X402_NETWORK=hedera:testnet
#
# Fee-payer credentials (ECDSA). Required because Hedera x402 settlement is a native
# TransferTransaction: HashPack only partially signs (buyer authorizes the HBAR move);
# the facilitator must co-sign as fee payer, pay network fees, and submit to consensus.
# The Next.js app never sees this key — only the facilitator container does.
# Create a dedicated ECDSA testnet account, fund it with HBAR, and paste id + key here.
FACILITATOR_ACCOUNT_ID=0.0.xxxxxx
FACILITATOR_PRIVATE_KEY=
# Optional custom consensus node endpoint for private Hedera networks.
HEDERA_NODE_URL=

# --- EdGraph monitoring worker ---
# Monitoring interval in milliseconds (default: 60000 = 1 minute)
EDGRAPH_MONITOR_INTERVAL_MS=60000

# --- EdGraph shared backend ---
# Used by the Next.js app. Keep the database file local and out of git.
EDGRAPH_DB_PATH=.data/edgraph.sqlite

# --- EdGraph live Graph + paid Evidence API ---
# Configure these in packages/nextjs/.env for the Next.js service.
EDGRAPH_GRAPH_ENDPOINT=https://gateway.thegraph.com/api/c71b0bd685814c60d1a641b9d0bba7b8/subgraphs/id/5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
EDGRAPH_GRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
EDGRAPH_GRAPH_API_KEY=c71b0bd685814c60d1a641b9d0bba7b8
EDGRAPH_GRAPH_POOL_ADDRESS=0x88e6a0c2ddd26feeb64f039a2c41296fcb3f5640
EDGRAPH_STABLECOIN_ADDRESS=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
EDGRAPH_STABLECOIN_SYMBOL=USDC
EDGRAPH_QUOTE_TOKEN_ADDRESS=0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2
EDGRAPH_QUOTE_TOKEN_SYMBOL=WETH
EDGRAPH_QUOTE_TOKEN_USD_PRICE=2500
EDGRAPH_EVIDENCE_PRICE_TINYBAR=1000000
EDGRAPH_EVIDENCE_PAY_TO_ACCOUNT_ID=0.0.10426282
EDGRAPH_GRAPH_SERVICE_URL=http://localhost:3000/api/graph/snapshot
EDGRAPH_AGENT_ACCOUNT_ID=0.0.10461760
