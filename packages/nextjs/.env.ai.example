# ============================================
# AI CLAIMS AGENT CONFIGURATION
# ============================================

# Google Gemini API Key (REQUIRED)
# Get FREE key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...YOUR_KEY_HERE

# ============================================
# AGENT CREDENTIALS (for x402 payments)
# ============================================

# Hedera testnet account with funded HBAR
EDGRAPH_AGENT_ACCOUNT_ID=0.0.1234
EDGRAPH_AGENT_PRIVATE_KEY=302e...

# ============================================
# EVIDENCE API CONFIGURATION
# ============================================

# Evidence API endpoint (default: localhost)
EDGRAPH_EVIDENCE_API_URL=http://localhost:3000/api/v1/depeg-evidence

# Evidence price in tinybars (0.001 HBAR = 100,000 tinybars)
EDGRAPH_EVIDENCE_PRICE_TINYBAR=100000

# ============================================
# BUDGET CONFIGURATION
# ============================================

# Agent's total HBAR budget in tinybars
# 1,000,000 tinybars = 0.01 HBAR
EDGRAPH_AGENT_HBAR_BUDGET_TINYBAR=1000000

# ============================================
# NETWORK CONFIGURATION
# ============================================

# x402 payment network (testnet or mainnet)
X402_NETWORK=hedera:testnet

# Hedera RPC endpoint (optional, uses default if not set)
HEDERA_RPC_URL=https://testnet.hashio.io/api
